set.current(processors=4)
set.seed(seed=20261114)
make.contigs(file=reads.files)
summary.seqs(fasta=current,count=current)
screen.seqs(fasta=current,count=current,maxambig=0,minlength=400,maxlength=550,maxhomop=8)
unique.seqs(fasta=current,count=current)
chimera.vsearch(fasta=current,count=current,dereplicate=t)
classify.seqs(fasta=current,count=current,reference=targets.16s.fasta,taxonomy=targets.taxonomy,cutoff=80)
rename.file(fasta=current,count=current,taxonomy=current,prefix=final)
make.shared(count=final.count_table)
classify.otu(list=current,count=final.count_table,taxonomy=final.taxonomy,label=ASV)
quit()
